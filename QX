[general]
#================================================
# Quantumult X 精简稳定版
# 精简策略组 / 降低资源占用 / 长期稳定使用
#================================================

# 节点可用性检测（Google）
server_check_url=http://www.gstatic.com/generate_204

# 资源解析器
resource_parser_url=https://raw.githubusercontent.com/KOP-XIAO/QuantumultX/master/Scripts/resource-parser.js

# IP地理位置查询
geo_location_checker=http://ip-api.com/json/?lang=zh-CN, https://raw.githubusercontent.com/KOP-XIAO/QuantumultX/master/Scripts/IP_API.js

# 以下IP不经过QX处理（直连）
excluded_routes=239.255.255.250/32, 24.105.30.129/32, 185.60.112.157/32, 185.60.112.158/32, 182.162.132.1/32

# 以下域名不使用QX DNS
dns_exclusion_list=*.10099.com.cn, *.cmpassport.com, *.jegotrip.com.cn, *.icitymobile.mobi, id6.me, *.pingan.com.cn

# 屏蔽QUIC/STUN减少发热与后台UDP占用
udp_drop_list=443, STUN, QUIC

# 自动ICMP响应
icmp_auto_reply=true

[dns]
#================================================
# DNS 设置：加密 / 防污染 / 防泄露 / 更快
#================================================

# 禁止使用系统DNS
no-system

# 如需IPv6：
# 删除下面 no-ipv6
# 并在QX设置中开启“兼容性增强”

no-ipv6

# 优先使用 DoH3 (HTTP/3)，0-RTT 连接更快，失败自动回退 HTTP/2
prefer-doh3

# 防污染：当上游抢答返回这些被污染IP时，直接丢弃并等待其他上游结果
circumvent-ipv4-answer=127.0.0.1, 0.0.0.0

# 全局默认：国内外加密DoH并行查询，自动取最优结果
doh-server=https://dns.alidns.com/dns-query, https://doh.pub/dns-query, https://1.1.1.1/dns-query, https://8.8.8.8/dns-query

# 海外高污染风险域名：强制绑定海外DoH，防止国内DNS污染/抢答
doh-server=/*.google.com/https://8.8.8.8/dns-query
doh-server=/*.googleapis.com/https://8.8.8.8/dns-query
doh-server=/*.youtube.com/https://8.8.8.8/dns-query
doh-server=/*.github.com/https://1.1.1.1/dns-query
doh-server=/*.twitter.com/https://1.1.1.1/dns-query
doh-server=/*.x.com/https://1.1.1.1/dns-query
doh-server=/*.openai.com/https://1.1.1.1/dns-query
doh-server=/*.chatgpt.com/https://1.1.1.1/dns-query
doh-server=/*.claude.ai/https://1.1.1.1/dns-query
doh-server=/*.anthropic.com/https://1.1.1.1/dns-query
doh-server=/*.netflix.com/https://8.8.8.8/dns-query
doh-server=/*.telegram.org/https://1.1.1.1/dns-query

# Apple 服务指定DNS（保持原有，国内CDN解析更优）
server=/*.icloud.com/119.29.29.29
server=/*.icloud.com.cn/119.29.29.29

# 腾讯系指定DNS（保持原有）
server=/*.tencent.com/119.29.29.29
server=/*.weixin.com/119.29.29.29

